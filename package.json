{
  "name": "novo-torob",
  "version": "0.1.0",
  "private": true,
  "description": "Hamghadam — Tehran in-person shopping assistant (Phase 1 frontend foundation)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa:screens": "playwright test e2e/screens.spec.ts",
    "qa:search": "npm run build -- --webpack && playwright test -c playwright.search.config.ts",
    "qa:sellers": "npm run build -- --webpack && playwright test -c playwright.sellers.config.ts",
    "qa:assistant": "npm run build -- --webpack && playwright test -c playwright.assistant.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:init": "tsx scripts/db-init.ts",
    "db:import": "tsx scripts/db-import.ts",
    "db:import:fixture": "tsx scripts/db-import.ts --fixture --out data/fixture.sqlite",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:verify:fixture": "tsx scripts/db-verify.ts --db data/fixture.sqlite --expect-fixture",
    "eval": "tsx scripts/eval.ts",
    "eval:build": "tsx scripts/eval-build.ts",
    "advisor:coverage": "tsx scripts/advisor-coverage.ts",
    "agent:eval": "tsx scripts/agent-eval.ts"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
