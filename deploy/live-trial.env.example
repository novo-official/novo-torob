# PRIVATE live-model trial — values filled by the OWNER in their own shell. NEVER commit real values. The compile-time lock still applies.
AGENT_PROVIDER=openai-compatible
AGENT_BASE_URL=https://ai.boxapi.ir/ai/v1
AGENT_MODEL=openai/gpt-4o-mini
# AGENT_API_KEY=            # export it in your shell only
AGENT_LIVE_APPROVAL=APPROVED-<8+ letters/digits you choose>
AGENT_LIVE_APPROVAL_EXPIRES=<ISO time, within 72h>
AGENT_LIVE_ALLOW_BASE_URL=https://ai.boxapi.ir/ai/v1
AGENT_LIVE_ALLOW_MODEL=openai/gpt-4o-mini
AGENT_LIVE_PRICE_IN_PER_M=0.1725     # USD per 1M input tokens, read from https://boxapi.ir/docs/ai/models/ on the trial day
AGENT_LIVE_PRICE_OUT_PER_M=0.69
AGENT_LIVE_MAX_REQUESTS=40
AGENT_LIVE_MAX_USD=0.25
AGENT_LIVE_MAX_TOKENS=700
AGENT_LIVE_MAX_INPUT_TOKENS=12000
AGENT_LIVE_ADMIN_TOKEN=<random, >= 24 chars>
AGENT_LIVE_LEDGER_PATH=.cache/live-ledger.json
# stop switch: AGENT_LIVE_KILL=1 or create an empty file named .live-kill in the project root
