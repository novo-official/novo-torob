# PRIVATE live-model trial — values filled by the OWNER in their own shell. NEVER commit real values. The compile-time lock still applies.
AGENT_PROVIDER=openai-compatible
AGENT_BASE_URL=https://ai.boxapi.ir/ai/v1
AGENT_MODEL=gpt-6-luna                   # the model the owner selected. BoxAPI's model page lists it as `openai/gpt-6-luna`; if the first (guarded) call is rejected with an unknown-model error, switch BOTH AGENT_MODEL and AGENT_LIVE_ALLOW_MODEL to that spelling
# BOXAPI_API_KEY=            # export it in your shell only (server-side; also accepted as AGENT_API_KEY). Never in the repo, the browser or a log
AGENT_LIVE_APPROVAL=APPROVED-<8+ letters/digits you choose>
AGENT_LIVE_APPROVAL_EXPIRES=<ISO time, within 72h>
AGENT_LIVE_ALLOW_BASE_URL=https://ai.boxapi.ir/ai/v1
AGENT_LIVE_ALLOW_MODEL=gpt-6-luna
AGENT_LIVE_PRICE_IN_PER_M=0.115      # USD per 1M input tokens, https://boxapi.ir/docs/ai/models/ (openai/gpt-6-luna), read 2026-10-23; re-read on the trial day
AGENT_LIVE_PRICE_OUT_PER_M=0.575
AGENT_LIVE_MAX_REQUESTS=100
AGENT_LIVE_MAX_USD=0.25
AGENT_LIVE_MAX_TOKENS=700
AGENT_LIVE_MAX_INPUT_TOKENS=12000
AGENT_LIVE_ADMIN_TOKEN=<random, >= 24 chars>
AGENT_LIVE_LEDGER_PATH=.cache/live-ledger.json
# model-parameter compatibility (only if the first call is rejected for these parameters):
# AGENT_TOKEN_PARAM=max_completion_tokens
# AGENT_SEND_TEMPERATURE=0
# stop switch: AGENT_LIVE_KILL=1 or create an empty file named .live-kill in the project root
