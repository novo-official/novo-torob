# syntax=docker/dockerfile:1
# LIARA VARIANT of ./Dockerfile (template — never deployed from here; see docs/liara-readiness.md).
# Differences from the local Dockerfile: (1) NO `VOLUME` instruction (Liara docs: remove it when using a Liara disk);
# (2) the data directory lives under WORKDIR (/app/data) because Liara requires an absolute disk path that includes the WORKDIR name.
# The local Dockerfile + docker-compose.yml (VOLUME /data) stay the proven local runtime; this file does not replace them.
# The dataset database is NOT baked into the image (and .data/, data/, *.sqlite are excluded by .dockerignore/.liaraignore).
FROM node:24-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS build
# NEXT_PUBLIC_* values are inlined at BUILD time (also the CSP img-src derived from the tile URL). Leave unset for the default; see docs/deployment-packet.md §7.
ARG NEXT_PUBLIC_MAP_TILE_URL
ARG NEXT_PUBLIC_MAP_TILE_ATTRIBUTION
ARG NEXT_PUBLIC_MAP_TILES_DISABLED
COPY . .
RUN npm run build

# One-shot tools (db:import / db:verify). Needs tsx + sources; never part of the runtime image.
FROM deps AS tools
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
ENV DATABASE_PATH=/data/app.sqlite
RUN mkdir -p /data && chown node:node /data
USER node
CMD ["npm", "run", "db:import", "--", "--zip", "/source/torob-dataset.zip"]

FROM base AS runner
# REQUIRE_MIN_PRODUCTS: a fixture/partial database mounted by mistake is refused (ready=503, pages say "unavailable") instead of being served as if it were the real catalog.
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 DATABASE_PATH=/app/data/app.sqlite REQUIRE_MIN_PRODUCTS=225903
# The Liara disk is attached ON TOP of /app/data only (never /app, which holds server.js). The empty dir keeps the image bootable without a disk (/api/ready then reports not_ready).
RUN mkdir -p /app/data && chown node:node /app/data
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 3000
# Liveness only (does not require the database). Readiness is /api/ready.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
