{
  "platform": "docker",
  "app": "<LIARA_APP_ID — owner-created, not invented>",
  "port": 3000,
  "build": {
    "dockerfile": "deploy/liara/Dockerfile.liara",
    "cache": true,
    "args": [
      "NEXT_PUBLIC_MAP_TILES_DISABLED=1"
    ]
  },
  "disks": [
    {
      "name": "<DISK_NAME — owner-approved>",
      "mountTo": "/app/data"
    }
  ]
}
