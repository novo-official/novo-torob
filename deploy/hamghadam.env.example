# Server-side environment. For the offline/mock product NO secret is required. Never commit the real file (.env.* is git-ignored).
NODE_ENV=production
DATABASE_PATH=/data/app.sqlite

# --- assistant (read docs/live-ai-trial-runbook.md before changing) ---
AGENT_PROVIDER=mock                 # mock = offline deterministic planner (NOT a language model) | disabled. Anything else is code-locked.
AGENT_EVIDENCE_MODE=off             # off | fixture (demo only). Do NOT set live without the owner's rights review.
# AGENT_EVIDENCE_REPRODUCE=0        # leave unset: third-party review pages stay LINK-ONLY
AGENT_RATE_PER_MIN=30               # per process; a single instance is assumed
AGENT_MAX_CONCURRENT=4
API_POST_RATE_PER_MIN=120           # /api/sellers and /api/compare/sellers POST

# --- reverse proxy ---
TRUST_PROXY_HEADERS=1               # only when the proxy OVERWRITES X-Forwarded-For (see Caddyfile.example / nginx.conf.example)

# --- map tiles (decision pending, see docs/deployment-packet.md §7) ---
# These are BUILD-time values (NEXT_PUBLIC_*): pass them as docker build args, e.g.
#   docker build --target runner --build-arg NEXT_PUBLIC_MAP_TILE_URL='https://<provider>/{z}/{x}/{y}.png' --build-arg NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='© <provider text required by its terms> (plain text; it is HTML-escaped)' -t hamghadam-app:<TAG> .
# NEXT_PUBLIC_MAP_TILES_DISABLED=1   # list-only mode: no tile host is contacted at all and the CSP carries no tile host
