# Upload-context exclusions for `liara deploy`. Never upload data, secrets or test artifacts.
# ROOT-ANCHORED on purpose: Liara matches bare names at any depth, and a bare `data` would also drop the source route src/app/data (the /data page).
/.git
/.data
/data
/.cache
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.zip
*.mp4
node_modules
/.next
/coverage
/test-results
/playwright-report
/qa-artifacts
/docs/qa
# nested copies (patterns above are root-anchored)
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-wal
**/*.db-shm
**/*.mp4
**/.env
**/.env.*
!.env.example
/.claude
/.brud
